Tabs.Auto:Title("Bomb Defusal")

Tabs.Auto:Button({
    Text = "Cut ONE Safe Wire", Tooltip = "Finds one uncut safe wire and cuts it",
    Callback = function()
        local db = workspace:FindFirstChild("DisarmBomb")
        if not db or not db:FindFirstChild("Wires") then
            win:Notify({ Title = "No active bomb found.", Icon = "alert-circle" })
            return
        end
        local cut = false
        for _, wire in ipairs(db.Wires:GetChildren()) do
            local badVal = wire:FindFirstChild("bad")
            if badVal and badVal.Value == false then
                pcall(function() Remote.CutWire:FireServer(wire.Name) end)
                win:Notify({ Title = "Cut " .. string.upper(wire.Name) .. " wire!", Icon = "check" })
                cut = true
                break
            end
        end
        if not cut then
            win:Notify({ Title = "No uncut safe wires found.", Icon = "alert-circle" })
        end
    end
})

Tabs.Auto:Button({
    Text = "Cut ALL Safe Wires", Tooltip = "Automatically cuts every safe wire on the bomb",
    Callback = function()
        local db = workspace:FindFirstChild("DisarmBomb")
        if not db or not db:FindFirstChild("Wires") then
            win:Notify({ Title = "No active bomb found.", Icon = "alert-circle" })
            return
        end
        task.spawn(function()
            local cutCount = 0
            for _, wire in ipairs(db.Wires:GetChildren()) do
                local badVal = wire:FindFirstChild("bad")
                if badVal and badVal.Value == false then
                    pcall(function() Remote.CutWire:FireServer(wire.Name) end)
                    cutCount = cutCount + 1
                    task.wait(0.2)
                end
            end
            win:Notify({ Title = "Cut " .. cutCount .. " safe wires!", Icon = "check" })
        end)
    end
})

