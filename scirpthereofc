-- [ RENDER LOOP (ESP) ]

local FullbrightConn = nil

RunService.Heartbeat:Connect(function()
    local drawEspEnabled = Settings.drawEspEnabled
    local iconEspEnabled = Settings.iconEspEnabled

    if not drawEspEnabled and not iconEspEnabled then
        clearAllESP()
        return
    end
    
    local normalCol = Settings.NormalColor
    local chainCol  = Settings.ChainedColor
    local dangerCol = Settings.DangerColor

    local seenPlayers = {}

    for _, char in ipairs(workspace:GetChildren()) do
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local plr = Players:GetPlayerFromCharacter(char)
        if not plr or plr == lp then continue end

        local name = char.Name
        seenPlayers[name] = true

        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        if drawEspEnabled then
            local d = getESPDrawings(name)
            local pos, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3, 0))
            if onScreen then
                local isChained = hasCard(char, "Chained")
                local hasVeng = hasCard(char, "Vengeance")
                local hasJest = hasCard(char, "Jester")
                
                local dotColor = (hasVeng or hasJest) and dangerCol or (isChained and chainCol or normalCol)

                d.outline.Position = Vector2.new(pos.X, pos.Y)
                d.outline.Visible = true

                d.dot.Color = dotColor
                d.dot.Position = Vector2.new(pos.X, pos.Y)
                d.dot.Visible = true

                local cards = char:FindFirstChild("Cards")
                local cardList = {}
                if cards then
                    for _, c in ipairs(cards:GetChildren()) do table.insert(cardList, c.Name) end
                end
                local cardStr = #cardList > 0 and table.concat(cardList, " | ") or "No Cards"
                d.text.Text = name .. "\n" .. cardStr
                d.text.Color = dotColor
                d.text.Position = Vector2.new(pos.X, pos.Y + 8)
                d.text.Visible = true
                if hasVeng or hasJest then
                    local txt = "[ WARNING: "
                    if hasVeng and hasJest then txt = txt .. "VENGEANCE & JESTER"
                    elseif hasVeng then txt = txt .. "VENGEANCE"
                    elseif hasJest then txt = txt .. "JESTER" end
                    txt = txt .. " ]"
                    
                    d.warnText.Text = txt
                    d.warnText.Color = Color3.fromRGB(255, 40, 40)
                    d.warnText.Position = Vector2.new(pos.X, pos.Y - 22)
                    d.warnText.Visible = true
                else
                    d.warnText.Visible = false
                end
            else
                d.outline.Visible = false
                d.dot.Visible = false
                d.text.Visible = false
                d.warnText.Visible = false
            end
        else
            if drawingESP[name] then
                drawingESP[name].outline.Visible = false
                drawingESP[name].dot.Visible = false
                drawingESP[name].text.Visible = false
                drawingESP[name].warnText.Visible = false
            end
        end
        if iconEspEnabled then
            local gui = getIconESP(name)
            if gui then
                gui.Enabled = true
                gui.Adornee = hrp
                local cardsFolder = char:FindFirstChild("Cards")
                local cardsFrame = gui:FindFirstChild("MainFrame") and gui.MainFrame:FindFirstChild("Cards")
                local holder = gui:FindFirstChild("MainFrame") and gui.MainFrame:FindFirstChild("Holder")
                if cardsFolder and cardsFrame and holder then
                    local currentCards = {}
                    for _, c in ipairs(cardsFolder:GetChildren()) do currentCards[c.Name] = true end
                    
                    for _, c in ipairs(cardsFrame:GetChildren()) do
                        if not c:IsA("UIListLayout") and not currentCards[c.Name] then
                            c:Destroy()
                        end
                    end
                    for cName in pairs(currentCards) do
                        if not cardsFrame:FindFirstChild(cName) then
                            local template = holder:FindFirstChild(cName)
                            if template then
                                local clone = template:Clone()
                                clone.Name = cName
                                clone.Parent = cardsFrame
                                clone.Visible = true
                            end
                        end
                    end
                end
            end
        else
            if iconESPGuis[name] then iconESPGuis[name].Enabled = false end
        end
    end
    for name in pairs(drawingESP) do
        if not seenPlayers[name] then
            clearESP(name)
        end
    end
end)

