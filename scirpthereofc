task.spawn(function()
    while true do
        if Options.ElimAssist and Options.ElimAssist.Value then
            local et = workspace:FindFirstChild("ElimTarget")
            if et and et:FindFirstChild("Target") and et.Target.Value ~= "" then
                local targetPlayer = Players:FindFirstChild(et.Target.Value)
                if targetPlayer then
                    local delay = math.random(Options.ElimDelayMin.Value * 100, Options.ElimDelayMax.Value * 100) / 100
                    task.wait(delay)
                    if Options.ElimAssist.Value and et:FindFirstChild("Target") and et.Target.Value == targetPlayer.Name then
                        ReplicatedStorage.Remote.PickPlayerRevolver:FireServer(targetPlayer)
                    end
                end
            end
        end
        task.wait(0.01)
    end
end)

task.spawn(function()
    while true do
        if Options.PotatoAuto and Options.PotatoAuto.Value then
            local hp = workspace:FindFirstChild("HotPotato")
            if hp then
                local holder = hp:FindFirstChild("CurrentHolder") or hp:FindFirstChild("Player")
                local canThrow = hp:FindFirstChild("CanBeThrown")
                
                if holder and holder.Value == LocalPlayer and (not canThrow or canThrow.Value == true) then
                    local potentialVictims = {}
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                            local isSafe = true
                            if Options.PotatoSafe.Value then
                                local char = workspace:FindFirstChild(p.Name)
                                if char and char:FindFirstChild("Cards") and char.Cards:FindFirstChild("Vengeance") then isSafe = false end
                            end
                            if Options.PotatoFriend.Value and LocalPlayer:IsFriendsWith(p.UserId) then isSafe = false end
                            if isSafe then table.insert(potentialVictims, p) end
                        end
                    end
                    
                    if #potentialVictims > 0 then
                        local victim = potentialVictims[math.random(1, #potentialVictims)]
                        local throwRemote = ReplicatedStorage.Remote:FindFirstChild("ThrowBombToPlayer")
                        if throwRemote then
                            throwRemote:FireServer(victim)
                        end
                        if victim.Character and victim.Character:FindFirstChild("HumanoidRootPart") then
                            firetouchinterest(LocalPlayer.Character.PrimaryPart, victim.Character.PrimaryPart, 0)
                            firetouchinterest(LocalPlayer.Character.PrimaryPart, victim.Character.PrimaryPart, 1)
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

