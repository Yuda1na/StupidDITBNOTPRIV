Tabs.Settings:Button({
    Text = "Save Config", Tooltip = "Saves your current settings",
    Callback = function()
        local name = ConfigName
        if name == "" then name = "default" end
        local values = win:GetValues()
        if writefile then
            if not isfolder("rawr3_save") then makefolder("rawr3_save") end
            writefile("rawr3_save/" .. name .. ".json", game:GetService("HttpService"):JSONEncode(values))
            win:Notify({ Title = "Saved config: " .. name, Icon = "check" })
        else
            win:Notify({ Title = "Executor doesn't support writefile", Icon = "alert-circle" })
        end
    end
})

Tabs.Settings:Button({
    Text = "Load Config", Tooltip = "Loads your saved settings",
    Callback = function()
        local name = ConfigName
        if name == "" then name = "default" end
        local path = "rawr3_save/" .. name .. ".json"
        if isfile and isfile(path) then
            local data = readfile(path)
            local success, values = pcall(function() return game:GetService("HttpService"):JSONDecode(data) end)
            if success and type(values) == "table" then
                win:SetValues(values)
                win:Notify({ Title = "Loaded config: " .. name, Icon = "check" })
            else
                win:Notify({ Title = "Failed to parse config", Icon = "alert-circle" })
            end
        else
            win:Notify({ Title = "Config not found: " .. name, Icon = "alert-circle" })
        end
    end
})

