local function randDelay(minV, maxV)
    local base = minV + math.random() * (maxV - minV)
    local jitter = (math.random() + math.random() + math.random() - 1.5) * 0.08
    return math.max(minV, base + jitter)
end

local function getChar() return lp.Character end

local function getAlivePlayers(excludeSelf)
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if excludeSelf and p == lp then continue end
        local char = workspace:FindFirstChild(p.Name)
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            table.insert(list, p)
        end
    end
    return list
end

local function hasCard(playerOrChar, cardName)
    local char = playerOrChar
    if typeof(playerOrChar) == "Instance" and playerOrChar:IsA("Player") then
        char = workspace:FindFirstChild(playerOrChar.Name)
    end
    if not char then return false end
    local cards = char:FindFirstChild("Cards")
    return cards and cards:FindFirstChild(cardName) ~= nil
end

local function pickSafestTarget()
    local candidates = {}
    for _, p in ipairs(getAlivePlayers(true)) do
        if mg.ignoreFriends and lp:IsFriendsWith(p.UserId) then continue end
        if mg.ignoreDangerous and (hasCard(p, "Vengeance") or hasCard(p, "Jester")) then continue end
        table.insert(candidates, p)
    end
    
    if #candidates == 0 and mg.ignoreDangerous then
        for _, p in ipairs(getAlivePlayers(true)) do
            if mg.ignoreFriends and lp:IsFriendsWith(p.UserId) then continue end
            if hasCard(p, "Vengeance") then continue end
            table.insert(candidates, p)
        end
    end
    
    if #candidates == 0 and mg.ignoreDangerous then
        for _, p in ipairs(getAlivePlayers(true)) do
            if hasCard(p, "Vengeance") then continue end
            table.insert(candidates, p)
        end
    end
    
    if #candidates == 0 then
        candidates = getAlivePlayers(true)
    end
    
    if #candidates == 0 then return nil end
    return candidates[math.random(#candidates)]
end

-- [ ESP LOGIC (Restored Icon ESP + Drawing ESP) ]

local drawingESP = {}  
local iconESPGuis = {} 

local function getESPDrawings(name)
    if drawingESP[name] then return drawingESP[name] end
    local outline = Drawing.new("Circle")
    outline.Filled = true; outline.NumSides = 12; outline.Radius = 5
    outline.Color = Color3.new(0, 0, 0); outline.Visible = false

    local dot = Drawing.new("Circle")
    dot.Filled = true; dot.NumSides = 12; dot.Radius = 3.5
    dot.Visible = false

    local text = Drawing.new("Text")
    text.Size = 14; text.Outline = true; text.Center = true
    text.Font = 2; text.Visible = false

    local warnText = Drawing.new("Text")
    warnText.Size = 14; warnText.Outline = true; warnText.Center = true
    warnText.Font = 2; warnText.Visible = false

    drawingESP[name] = { outline = outline, dot = dot, text = text, warnText = warnText }
    return drawingESP[name]
end

local function getIconESP(name)
    if iconESPGuis[name] then return iconESPGuis[name] end
    
    local rsVision = ReplicatedStorage:FindFirstChild("VisionCards")
    if not rsVision then return nil end
    
    local clone = rsVision:Clone()
    local targetParent = (gethui and gethui()) or CoreGui
    clone.Parent = targetParent
    clone.Name = "ESP_" .. name
    
    iconESPGuis[name] = clone
    return clone
end

local function clearESP(name)
    if drawingESP[name] then 
        drawingESP[name].outline:Remove()
        drawingESP[name].dot:Remove()
        drawingESP[name].text:Remove()
        drawingESP[name].warnText:Remove()
        drawingESP[name] = nil
    end
    if iconESPGuis[name] then
        iconESPGuis[name]:Destroy()
        iconESPGuis[name] = nil
    end
end

local function clearAllESP()
    for name in pairs(drawingESP) do clearESP(name) end
end

-- [ MINIGAME STATE ]

local manualOverride = {}
local lastFired = {}

local function wasManuallyOverridden(key)
    return manualOverride[key] and (tick() - manualOverride[key]) < 5
end

local function canFire(key, cooldown)
    local now = tick()
    if wasManuallyOverridden(key) then return false end
    
    if not lastFired[key] or (now - lastFired[key]) >= cooldown then
        lastFired[key] = now
        return true
    end
    return false
end

local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if not checkcaller() and method == "FireServer" and typeof(self) == "Instance" and self.ClassName == "RemoteEvent" then
        local name = self.Name
        local now = tick()
        if name == "PickPlayerRevolver" then manualOverride["duel"] = now; manualOverride["roulette"] = now; manualOverride["revolver"] = now
        elseif name == "PickPlayer" or name == "PickPlayerTarget" then manualOverride["elim"] = now
        elseif name == "ThrowBombToPlayer" or name == "ThrowBomb" then manualOverride["potato"] = now
        elseif name == "PutOutFire" then manualOverride["fire"] = now; manualOverride["putOutFire"] = now
        elseif name == "SawEvent" then manualOverride["saw"] = now
        elseif name == "QuickTimeReact" then manualOverride["qte"] = now
        elseif name == "RealPickPlayerRevolver" then manualOverride["revolver"] = now
        elseif name == "SplitOrSteal" then manualOverride["splitsteal"] = now
        elseif name == "PromptRisk" then manualOverride["revolverRisk"] = now
        elseif name == "SavePlayer" then manualOverride["savePlayer"] = now
        elseif name == "PassBombButton" or name == "PressBombButton" then manualOverride["passBombButton"] = now; manualOverride["pressBombButton"] = now
        elseif name == "ChoseDirection" then manualOverride["stab"] = now
        end
    end
    return OldNamecall(self, ...)
end)

