local function UpdateIconESP(obj, state)
    local visionGui = obj:FindFirstChild("VisionCards", true)
    local hrp = obj:FindFirstChild("HumanoidRootPart")
    if hrp and visionGui then
        visionGui.Enabled = state
        visionGui.Adornee = state and hrp or nil
    end
end

local function UpdateTextESP(obj, state)
    local name = obj.Name
    local hrp = obj:FindFirstChild("HumanoidRootPart")
    local hum = obj:FindFirstChild("Humanoid")
    if not state or (hum and hum.Health <= 0) then
        if DrawingEntities[name] then DrawingEntities[name].Visible = false end
        return
    end
    if hrp then
        if not DrawingEntities[name] then
            local t = Drawing.new("Text")
            t.Size = 18; t.Outline = true; t.Center = true
            DrawingEntities[name] = t
        end
        local t = DrawingEntities[name]
        local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 4, 0))
        if onScreen then
            local cardList = {}
            local hasChained = false
            local cardsFolder = obj:FindFirstChild("Cards")
            if cardsFolder then
                for _, c in pairs(cardsFolder:GetChildren()) do 
                    table.insert(cardList, c.Name)
                    if string.find(c.Name, "Chained") then hasChained = true end
                end
                t.Text = #cardList > 0 and table.concat(cardList, "\n") or "No Cards"
            end
            t.Position = Vector2.new(vector.X, vector.Y)
            t.Color = hasChained and Options.ChainedColor.Value or Options.NormalColor.Value
            t.Visible = true
        else t.Visible = false end
    end
end

RunService.Heartbeat:Connect(function()
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:FindFirstChild("Humanoid") and obj ~= LocalPlayer.Character then
            UpdateIconESP(obj, Options.IconESP.Value)
            UpdateTextESP(obj, Options.TextESP.Value)
        end
    end

    if Options.AutoQTE.Value then
        local qt = workspace:FindFirstChild("QuickTime")
        if qt and qt.PlayerChosen.Value == LocalPlayer and qt.TimeRemaining.Value > 0 then
            ReplicatedStorage.Remote.QuickTimeReact:FireServer()
        end
    end
end)

